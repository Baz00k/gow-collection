# Shared gow-collection base image (Fedora). Pinned to a digest published to
# our own GHCR, which (unlike the upstream Fedora registry) retains old digests,
# so this pin never rots. The digest is bumped automatically by the base-image
# update flow whenever a new base is published.
BASE_APP_IMAGE=ghcr.io/baz00k/gow-collection/base:edge@sha256:e18651df0e0318e91f2228c7cf6486f331390c2a288e5e6f3d2ca07eec713ebe

# Eden Nintendo Switch emulator. Linux builds are published as AppImages from
# the project's own stable mirror; upstream ships no checksum file, so the
# SHA256 below is computed from the downloaded artifact by update/apply.sh.
#
# PGO builds are upstream's recommended Linux artifact. This is the generic
# amd64 target (Haswell/Ryzen or newer); use the "legacy" target in the same
# release directory for older CPUs. See the README for the other variants.
EDEN_VERSION=0.2.1
EDEN_APPIMAGE_URL=https://stable.eden-emu.dev/v0.2.1/Eden-Linux-v0.2.1-amd64-clang-pgo.AppImage
EDEN_APPIMAGE_SHA256=7a28bf988b0648831989722bdbaa90ab31371b403808199813e0ea7c8b25ba6d
