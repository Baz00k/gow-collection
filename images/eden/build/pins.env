# Linux builds are AppImages from the upstream stable mirror; PGO is upstream's
# recommended build. This is the generic amd64 target, `legacy-clang-pgo` covers
# pre-Haswell/pre-Ryzen CPUs. update/apply.sh pins the SHA256 from the download.
EDEN_VERSION=0.2.1
EDEN_APPIMAGE_URL=https://stable.eden-emu.dev/v0.2.1/Eden-Linux-v0.2.1-amd64-clang-pgo.AppImage
