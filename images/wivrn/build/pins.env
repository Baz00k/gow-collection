# Shared gow-collection base image (Fedora). Pinned to a digest published to
# our own GHCR, which (unlike the upstream Fedora registry) retains old digests,
# so this pin never rots. The digest is bumped automatically by the base-image
# update flow whenever a new base is published.
BASE_APP_IMAGE=ghcr.io/baz00k/gow-collection/base:edge@sha256:61f5f0f8be6b1130270382b5898254983c31eb90df20b2593b0f078ad999311d

# RPM Fusion repositories for Steam
RPMFUSION_FREE_URL=https://download1.rpmfusion.org/free/fedora/rpmfusion-free-release-44.noarch.rpm
RPMFUSION_FREE_SHA256=8af2dbb02e3a72f0961ec79cf1ea3f350719cb830b0f99f59e939389feb34b1c
RPMFUSION_NONFREE_URL=https://download1.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-44.noarch.rpm
RPMFUSION_NONFREE_SHA256=c2606f494b0c4417bf6632f865448da3febb420e19182e47874d8db4c35a8a8e

# WiVRn server (source build). The Quest client and the server versions must
# match, and Fedora lags upstream, so the pinned upstream release is built
# from source. Bumped by images/wivrn/update/*.
WIVRN_VERSION=26.9
WIVRN_TARBALL_URL=https://github.com/WiVRn/WiVRn/archive/refs/tags/v26.9.tar.gz
WIVRN_TARBALL_SHA256=89f63bc6c89943f3571055381ee2f1aa744d3d11372c56188b21e39c8d8ef733
WIVRN_REPO=WiVRn/WiVRn

# XR SIG Fedora 44 build from xrizer commit 0989a7fac2d1efb7ea82f5fe1a8ed30c3eeb9596.
# This build implements IVRSystem_026; keep OpenComposite as the default for
# games already working, and select xrizer per game with VR_OVERRIDE.
XRIZER_RPM_URL=https://download.copr.fedorainfracloud.org/results/@xr-sig/xrizer/fedora-44-x86_64/Packages/x/xrizer-0.5%5E20260903git0989a7f-1.fc44.x86_64.rpm
XRIZER_RPM_SHA256=7ae87615bafde06518c06d2232d087d5574eebab53b3eca8ec41b6996e874160
