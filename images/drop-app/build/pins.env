# Shared gow-collection base image (Fedora). Pinned to a digest published to
# our own GHCR, which (unlike the upstream Fedora registry) retains old digests,
# so this pin never rots. The digest is bumped automatically by the base-image
# update flow whenever a new base is published.
BASE_APP_IMAGE=ghcr.io/baz00k/gow-collection/base:edge@sha256:81fbb58cb0f778b2b23c950934c314cbb8eb3bb1e1b2f5002f30534a9d15fa37

DROP_APP_VERSION=0.4.0
DROP_APP_TAG=v0.4.0-rc-6
DROP_APP_RPM_X86_64_URL=https://github.com/Drop-OSS/drop/releases/download/v0.4.0-rc-6/Drop.Desktop.Client-0.4.0-1.x86_64.rpm
DROP_APP_RPM_X86_64_SHA256=1636f5906bdd3ef19a410a88c5e4d976bd05de26e00b7895ae1f1b35c86d9fe8
DROP_APP_REPO=Drop-OSS/drop

UMU_LAUNCHER_VERSION=1.4.4
UMU_LAUNCHER_RPM_FLAVOUR=fc44
UMU_LAUNCHER_RPM_X86_64_URL=https://github.com/Open-Wine-Components/umu-launcher/releases/download/1.4.4/umu-launcher-1.4.4.fc44.x86_64.rpm
