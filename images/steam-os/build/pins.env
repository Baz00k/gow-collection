# Shared gow-collection base image (Fedora). Pinned to a digest published to
# our own GHCR, which (unlike the upstream Fedora registry) retains old digests,
# so this pin never rots. The digest is bumped automatically by the base-image
# update flow whenever a new base is published.
BASE_APP_IMAGE=ghcr.io/baz00k/gow-collection/base:edge@sha256:9ba9165e5627b774e73d40dbb5f6a333201e2e7f424e2f700a66eede71276644

# Decky Loader — SteamOS plugin framework
DECKY_LOADER_VERSION=3.3.1
DECKY_LOADER_URL=https://github.com/SteamDeckHomebrew/decky-loader/releases/download/v3.3.1/PluginLoader
DECKY_LOADER_SHA256=7bb73b0502c49e7194f34f9ce4ddb6777764e9277d7a5e54665f66460d50c315
DECKY_LOADER_REPO=SteamDeckHomebrew/decky-loader
