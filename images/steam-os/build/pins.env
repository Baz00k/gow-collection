RPMFUSION_NONFREE_URL=https://download1.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-44.noarch.rpm
RPMFUSION_NONFREE_SHA256=c2606f494b0c4417bf6632f865448da3febb420e19182e47874d8db4c35a8a8e

